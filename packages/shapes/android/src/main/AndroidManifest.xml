<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The weights are fetched from Hugging Face on first use -- 1.3 MB for the
       LiteRT export, the smallest download of any model in this family by a wide
       margin. Everything else is on-device.

       Nothing else is declared, and that is worth noticing rather than
       overlooking: this is the first model here whose input comes from the
       screen. A stroke is a list of numbers the app already has, so unlike Clear,
       Voz, Uhm and Ear there is no microphone to ask for, and unlike none of them
       there is no file to read. -->
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
