    "prepare": "expo-module prepare",
    "expo-module": "expo-module"
  },
  "dependencies": {
    "@desert-ant-labs/react-native-core": "0.1.0"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "expo": "^57.0.0",
    "expo-module-scripts": "^56.0.3"
  }
