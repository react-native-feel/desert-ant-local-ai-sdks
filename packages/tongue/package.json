  ],
  "keywords": [
    "react-native",
    "expo",
    "expo-modules",
    "on-device",
    "language-identification",
    "language-detection",
    "text",
    "lid",
    "multilingual",
    "script-detection",
    "desert-ant-labs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "expo-module build && expo-module build plugin",
    "clean": "expo-module clean",
