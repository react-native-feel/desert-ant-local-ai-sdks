{
  "expo": {
    "name": "Desert Ant Example",
    "slug": "desert-ant-clear-example",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.desertant.clearexample",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a clip so Clear can clean it up, Voz can transcribe it and Uhm can find the filler words, on this device."
      }
    },
    "android": {
      "package": "com.desertant.clearexample",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-audio",
      "@desert-ant-labs/react-native-clear",
      "@desert-ant-labs/react-native-voz",
      "@desert-ant-labs/react-native-clips",
      "@desert-ant-labs/react-native-uhm",
      "@desert-ant-labs/react-native-emo",
      "@desert-ant-labs/react-native-ear",
      "@desert-ant-labs/react-native-tongue"
    ],
    "scheme": "clearexample"
  }
}
