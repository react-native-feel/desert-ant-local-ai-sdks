{
  "name": "desert-ant-react-native",
  "private": true,
  "version": "0.1.0",
  "description": "React Native / Expo SDKs for Desert Ant Labs on-device models.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @desert-ant-labs/react-native-core --workspace @desert-ant-labs/react-native-clear --workspace @desert-ant-labs/react-native-voz --workspace @desert-ant-labs/react-native-clips --workspace @desert-ant-labs/react-native-uhm --workspace @desert-ant-labs/react-native-emo --workspace @desert-ant-labs/react-native-ear",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "expo-module-scripts": "^56.0.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
